#!/bin/bash

for file in *.c *.js *.py; do # Перебираем все файлы
    if [ -f "$file" ]; then # Проверяем, существует ли реальный файл с таким именем
        line=$(head -n 1 "$file")
        if [[ "$file" == *.py ]]; then
            if [[ "$line" == \#* ]]; then # начинается ли первая строчка с решетки, ставим \ чтобы $
                echo "[ С КОММЕНТАРИЕМ ] $file"
            else
                echo "[ БЕЗ КОММЕНТАРИЯ ] $file"
            fi
        fi
        if [[ "$file" == *.c || "$file" == *.js ]]; then
            if [[ "$line" == //* || "$line" == /\** ]]; then
                echo "[ С КОММЕНТАРИЕМ ] $file"
            else
                echo "[ БЕЗ КОММЕНТАРИЯ ] $file"
            fi
        fi
    fi
done  
