nano check_comments.sh
#!/bin/bash

find . -type f \( -name "*.c" -o -name "*.js" -o -name "*.py" \) | while read -r file; do
    first_line=$(head -n 1 "$file")
    ext="${file##*.}"

    has_comment=0

    case "$ext" in
        c|js)
            if echo "$first_line" | grep -qE '^[[:space:]]*(\/\/|\/\*)'; then
                has_comment=1
            fi
            ;;
        py)
            if echo "$first_line" | grep -qE '^[[:space:]]*#'; then
                has_comment=1
            fi
            ;;
    esac

    if [ $has_comment -eq 1 ]; then
        echo "[ С КОММЕНТАРИЕМ ] $file"
    else
        echo "[ БЕЗ КОММЕНТАРИЯ ] $file"
    fi
done


chmod +x check_comments.sh
