#!/bin/bash

if [ "$#" -ne 2 ]; then
    echo "Ошибка: Укажите входной и выходной файлы."
    echo "Использование: $0 <входной_файл> <выходной_файл>"
    exit 1
fi
INPUT_FILE="$1"
OUTPUT_FILE="$2"
if [ ! -f "$INPUT_FILE" ]; then
    echo "Ошибка: Входной файл '$INPUT_FILE' не найден!"
    exit 1
fi
sed 's/    /\t/g' "$INPUT_FILE" > "$OUTPUT_FILE"
echo "Готово! Замена выполнена. Результат сохранен в '$OUTPUT_FILE'."

