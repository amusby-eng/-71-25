#!/bin/bash

if [ -z "$1" ]; then
    echo "Ошибка: Укажите путь к директории."
    echo "Использование: $0 <путь>"
    exit 1
fi

TARGET_DIR="$1"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Ошибка: Директория '$TARGET_DIR' не найдена!"
    exit 1
fi

find "$TARGET_DIR" -type f -exec sha256sum {} + 2>/dev/null | \
sort | \
awk '{
    hash = $1
    $1 = ""
    sub(/^ /, "", $0)
    file = $0
    
    if (hash == prev_hash) {
        if (printed == 0) {
            print "\n[ Группа дубликатов ]"
            print prev_file
            printed = 1
        }
        print file
    } else {
        prev_hash = hash
        prev_file = file
        printed = 0
    }
}'
