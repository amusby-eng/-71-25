#!/bin/bash

if [ -z "$1" ]; then
    echo "Ошибка: Укажите расширение файлов."
    echo "Использование: $0 <расширение>"
    exit 1
fi
EXT="$1"
FILES=$(find . -maxdepth 1 -type f -name "*.$EXT")
if [ -z "$FILES" ]; then
    echo "Файлы с расширением .$EXT не найдены."
    exit 1
fi
ARCHIVE_NAME="archive_$EXT.tar"
tar -cvf "$ARCHIVE_NAME" $FILES
echo "Успешно! Файлы с расширением .$EXT упакованы в '$ARCHIVE_NAME'."

